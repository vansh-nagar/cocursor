# Port the WebSocket signalling server listens on.
# The Next.js app reaches this via NEXT_PUBLIC_COLLAB_WS_URL.
PORT=8080

# Comma-separated origins allowed to connect (CORS + WS origin check).
ALLOWED_ORIGINS=http://localhost:3100

# Clerk issuer used to verify the token a client sends on join.
# Must match CLERK_JWT_ISSUER_DOMAIN used by Convex.
CLERK_JWT_ISSUER_DOMAIN=
