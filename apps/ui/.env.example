# ─── Convex ──────────────────────────────────────────────────────────────────
# From `bunx convex dev` (it prints and writes this for you on first run).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ─── Clerk ───────────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# NOTE: CLERK_JWT_ISSUER_DOMAIN is read by convex/auth.config.ts, which runs on
# the Convex backend — NOT by Next.js. Set it in the Convex dashboard
# (Settings → Environment Variables) or with:
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# Value = the "Issuer" URL of a Clerk JWT template named exactly "convex".

# ─── Groq (AI agent + inline completions) ────────────────────────────────────
# https://console.groq.com/keys
# Read implicitly by the default groq() provider. Without it every AI request 401s.
GROQ_API_KEY=gsk_xxx

# ─── Inngest (background agent jobs) ─────────────────────────────────────────
# Not needed for `bunx inngest-cli dev` locally; required once deployed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Collaboration server (apps/collab-api) ──────────────────────────────────
# Local: ws://localhost:8080 — deployed: must be wss:// or browsers block it
# as mixed content from an HTTPS page.
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:8080

# ─── WebRTC TURN (optional) ──────────────────────────────────────────────────
# STUN alone works on one machine and on a LAN. Calls between different
# networks need a TURN relay. Leave blank locally.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
